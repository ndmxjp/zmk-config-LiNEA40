/*
 * LiNEA40 keymap  --  macOS / US layout
 *
 * Modifier layout
 *   Ctrl : left thumb (inner) -- ^P ^N ^H ^K are right-hand letters
 *   Cmd  : right middle finger, bottom row -- its letters (C V X Z A S W Q T F)
 *          are left-hand ones, and Cmd is held rather than tapped, so it can
 *          afford the position Enter gave up. Japanese input taps Enter as often
 *          as Space, and both now sit under a thumb.
 *   Space, Enter, Ctrl, Cmd and both Shifts are plain &kp. Bspc is the only key
 *   in the typing flow still carrying a layer, so it uses &lt_tap -- see below.
 *
 * Layer numbers 1, 3 and 5 are also referenced by the PMW3610 trackball in
 * LiNEA40_right.overlay (automouse-layer / scroll-layers / snipe-layers).
 * Keep them in sync when renumbering.
 */

#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/*
 * Layer names are prefixed so the preprocessor cannot rewrite the keymap node
 * names below (a bare `#define MOUSE 1` turns a `MOUSE { }` node into `1 { }`).
 */
#define L_BASE  0
#define L_MOUSE 1   /* automouse-layer -- trackball moves */
#define L_NAV   2
#define L_SYM   3   /* scroll-layers   -- trackball scrolls */
#define L_MAC   4
#define L_SNIPE 5   /* snipe-layers    -- trackball precision */

/*
 * Two kinds of layer-tap, split by which half of the key gets used more.
 *
 * &lt is for keys whose HOLD is the common action -- Esc/SYM. "balanced" makes
 * the hold win as soon as another key is pressed and released, which is what a
 * layer key wants: hold it, press a symbol, get the symbol.
 *
 * &lt_tap is for keys whose TAP is the common action -- Bspc and the F that
 * reaches snipe mode. Those sit in the middle of typing, and "balanced"
 * alone breaks them: press Bspc, roll into the next letter before releasing it,
 * and decide_balanced() calls that HOLD_INTERRUPT -- the delete never happens
 * and the letter comes off the Nav layer instead. require-prior-idle-ms settles
 * the key as a tap outright when it follows another keypress closely, so these
 * always type while the hands are moving, and holding one still reaches its
 * layer once the typing pauses.
 */

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

/* Pointer movement (mouse keys) */

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

/* Pointer scrolling (encoder + mouse keys) */

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

/* NAV held -> encoder scrolls three times as fast */

&msc_input_listener {
    fast_scroll {
        layers = <L_NAV>;
        input-processors = <&zip_wheel_scaler 3 1>;
    };
};

/* SYM held -> trackball scrolls instead of moving the pointer.
 * SYM is reachable from the left middle finger, which keeps the whole right
 * hand free for the ball. Y is inverted to match macOS natural scrolling. */

&trackball_listener {
    scroller {
        layers = <L_SYM>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    behaviors {
        lt_tap: layer_tap_favouring_the_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        kp_enc: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        scrl_enc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    /*
     * A key that belongs to a combo has its press captured until the combo
     * resolves or times out, so no key used while typing belongs to one.
     * Space especially: it sat in a combo with Ctrl, its own neighbour under
     * the left thumb, which both delayed every space and turned a slightly
     * wide thumb press into ^Space. ^Space lives on the Nav and Mac layers
     * instead.
     *
     * require-prior-idle-ms drops these combos from the candidate list
     * entirely while keys are still flowing, which keeps the capture off the
     * letters they are built from -- "stdio" no longer risks a Delete. Rolling
     * the ball is not a keycode event, so the click combos stay live whenever
     * the hand is actually on the ball.
     */
    combos {
        compatible = "zmk,combos";

        del_key {
            bindings = <&kp DEL>;
            key-positions = <7 8>;
            require-prior-idle-ms = <150>;
        };

        mid_click {
            bindings = <&mkp MB3>;
            key-positions = <16 17>;
            require-prior-idle-ms = <150>;
        };

        right_click {
            bindings = <&mkp MB2>;
            key-positions = <17 18>;
            require-prior-idle-ms = <150>;
        };

        back_click {
            bindings = <&mkp MB4>;
            key-positions = <27 28>;
            require-prior-idle-ms = <150>;
        };

        fwd_click {
            bindings = <&mkp MB5>;
            key-positions = <26 27>;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * 40 keys. The bottom row carries five per half: the encoder occupies
         * the position between SYM and Space on the left, and the trackball the
         * one between Bspc and Cmd on the right. Neither is in the layout.
         *
         *  Q      W      E      R      T                  Y      U      I      O      P
         *  A      S      D      F      G                  H      J      K      L      -
         *  Z      X      C      V      B                  N      M      ,      .      ;
         *  Shift  Tab    SYM   (enc) Space Ctrl   Enter   Bspc  (ball)  Cmd    Esc    Shift
         *         (Alt)                                         (NAV)                (SYM)
         *
         * The right pinky home key is "-" rather than ";": it types the Japanese
         * long vowel mark, which turns up about as often as a letter. ";" drops a
         * row (Shift still gives ":"), and "/" moves to the Sym layer.
         */
        base_layer {
            display-name = "Base";
            bindings = <
&kp Q        &kp W          &kp E           &kp R        &kp T             &kp Y              &kp U               &kp I        &kp O            &kp P
&kp A        &kp S          &kp D           &kp F        &kp G             &kp H              &kp J               &kp K        &kp L            &kp MINUS
&kp Z        &kp X          &kp C           &kp V        &kp B             &kp N              &kp M               &kp COMMA    &kp DOT          &kp SEMI
&kp LSHFT    &mt LALT TAB   &mo L_SYM       &kp SPACE    &kp LCTRL         &kp ENTER          &lt_tap L_NAV BSPC  &kp LGUI     &lt L_SYM ESC    &kp RSHFT
            >;

            sensor-bindings = <&scrl_enc SCRL_DOWN SCRL_UP>;
        };

        /*
         * Layer 1 -- entered automatically while the trackball is moving
         * (automouse-layer in LiNEA40_right.overlay). Click cluster lands on
         * the right home row, under the hand already on the ball.
         *
         * Hold the left index (F) to slow the ball down; the left hand is idle
         * while the right one is on the ball. It is a hold-tap rather than a
         * plain &mo because this layer stays active for AUTOMOUSE_TIMEOUT_MS
         * after the ball stops, and a plain &mo would swallow the "f" of a word
         * typed right after nudging the ball.
         */
        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans     &trans         &trans          &trans           &trans                                  &trans      &trans           &trans              &trans      &trans
&trans     &trans         &trans          &lt_tap L_SNIPE F    &trans                                  &mkp MB3    &mkp MB1         &mkp MB2            &mkp MB4    &mkp MB5
&trans     &trans         &trans          &trans           &trans                                  &trans      &trans           &trans              &trans      &trans
&trans     &trans         &trans          &trans           &trans          &trans  &trans          &trans              &trans           &trans
            >;
        };

        /*
         * Layer 2 -- held by the right thumb (Bspc). A thumb hold leaves the
         * fingers of its own hand free, so the layer uses both halves: moving
         * around on the right, firing things off on the left.
         *
         *  Cmd-Alt-Lt Ctrl-Lt Ctrl-Up Ctrl-Rt Cmd-Alt-Rt   Alt-Lt Cmd-[ Cmd-]  Alt-Rt Del
         *  Ctrl-Spc   Cmd-Spc Cmd-`   Cmd-Alt-I Cmd-Alt-Esc  Left   Down  Up     Right  Cmd-Bspc
         *  Cmd-1      Cmd-2   Cmd-3   Cmd-Sft-4 Cmd-Sft-5    Home   PgDn  PgUp   End    Alt-Bspc
         *  Mute       Play                                                             (encoder: volume)
         *
         * The arrows sit on h j k l, on the keys and under the fingers Vim uses
         * -- including h as the index stretch. Around them the right hand grows
         * coarser outwards: character moves on the home row, line and page jumps
         * below, word moves and browser history above, the delete family down the
         * pinky column.
         *
         * The left hand holds what does not move a caret: window and space
         * switching on the top row, then the fixed-chord app shortcuts.
         *
         * Adding SYM on top of this reaches the Mac layer.
         */
        nav_layer {
            display-name = "Nav";
            bindings = <
&kp LG(LA(LEFT))&kp LC(LEFT)   &kp LC(UP)      &kp LC(RIGHT)&kp LG(LA(RIGHT))  &kp LA(LEFT)       &kp LG(LBKT)        &kp LG(RBKT) &kp LA(RIGHT)    &kp DEL
&kp LC(SPACE)&kp LG(SPACE)  &kp LG(GRAVE)   &kp LG(LA(I))&kp LG(LA(ESC))   &kp LEFT           &kp DOWN            &kp UP       &kp RIGHT        &kp LG(BSPC)
&kp LG(N1)   &kp LG(N2)     &kp LG(N3)      &kp LG(LS(N4))&kp LG(LS(N5))    &kp HOME           &kp PG_DN           &kp PG_UP    &kp END          &kp LA(BSPC)
&kp C_MUTE   &kp C_PP       &mo L_MAC       &trans       &trans            &trans             &trans              &trans       &trans           &trans
            >;

            sensor-bindings = <&kp_enc C_VOL_DN C_VOL_UP>;
        };

        /*
         * Layer 3 -- two entry points, so either hand can hold it:
         *   left index (x3)  -> right hand free  -> numbers and operators
         *   right ring (x11) -> left hand free   -> brackets and punctuation
         *
         * US layout, so Shift covers the rest: ~ from `, " from ', ? from /,
         * : from ;. Only the pairs that matter in code get an explicit key.
         *
         * Adding Nav on top of this reaches the Mac layer.
         */
        sym_layer {
            display-name = "Sym";
            bindings = <
&kp EXCL     &kp AT         &kp HASH        &kp DLLR     &kp PRCNT         &kp GRAVE          &kp N7              &kp N8       &kp N9           &kp ASTRK
&kp LBRC     &kp RBRC       &kp LPAR        &kp RPAR     &kp SQT           &kp AMPS           &kp N4              &kp N5       &kp N6           &kp SLASH
&kp LBKT     &kp RBKT       &kp LT          &kp GT       &kp UNDER         &kp PIPE           &kp N1              &kp N2       &kp N3           &kp PLUS
&trans       &trans         &trans          &trans       &trans            &kp N0             &mo L_MAC           &kp EQUAL    &trans           &trans
            >;

            sensor-bindings = <&kp_enc LG(Z) LG(LS(Z))>;
        };

        /*
         * Layer 4 -- reached by holding Nav and Sym together, in either order.
         * Enter used to carry it, but Enter is tapped far too often to sit on a
         * hold, and nothing else on the base layer was free. F-keys and pairing
         * are rare enough to live behind a two-key hold.
         *
         * Those two holds occupy the right thumb and the left middle finger, so
         * the contents sit on the right hand, whose fingers are all free.
         */
        mac_layer {
            display-name = "Mac";
            bindings = <
&trans       &trans         &trans          &trans       &trans            &kp F1             &kp F2              &kp F3       &kp F4           &kp F5
&trans       &trans         &trans          &trans       &trans            &kp F6             &kp F7              &kp F8       &kp F9           &kp F10
&trans       &trans         &trans          &trans       &trans            &kp F11            &kp F12             &bt BT_SEL 0 &bt BT_SEL 1     &bt BT_CLR
&bootloader  &studio_unlock &trans          &trans       &trans            &trans             &trans              &trans       &trans           &trans
            >;

            sensor-bindings = <&kp_enc C_VOL_DN C_VOL_UP>;
        };

        /*
         * Layer 5 -- trackball precision mode (snipe-layers), held from the
         * Mouse layer. It repeats that layer's click cluster rather than
         * falling through to the letters underneath: the driver only activates
         * the automouse layer while input_mode is MOVE (pmw3610.c), so in snipe
         * mode layer 1 is gone and its clicks with it -- which would leave the
         * ball able to aim precisely at something it cannot click.
         */
        snipe_layer {
            display-name = "Snipe";
            bindings = <
&trans     &trans         &trans          &trans       &trans                                      &trans      &trans           &trans              &trans      &trans
&trans     &trans         &trans          &trans       &trans                                      &mkp MB3    &mkp MB1         &mkp MB2            &mkp MB4    &mkp MB5
&trans     &trans         &trans          &trans       &trans                                      &trans      &trans           &trans              &trans      &trans
&trans     &trans         &trans          &trans       &trans          &trans      &trans          &trans              &trans           &trans
            >;
        };
    };
};
