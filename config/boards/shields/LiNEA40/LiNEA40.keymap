/*
 * LiNEA40 keymap  --  macOS / US layout
 *
 * Modifier layout
 *   Ctrl : left thumb (inner)   -- ^P ^N ^H ^K are right-hand letters
 *   Cmd  : right thumb (inner)  -- Cmd-C/V/X/Z/A/S/W/Q/T/F are left-hand letters
 *   Space, Ctrl, Cmd and both Shifts are plain &kp -- no hold-tap on any key
 *   that sits in the typing flow.
 *
 * Layer numbers 1, 3 and 5 are also referenced by the PMW3610 trackball in
 * LiNEA40_right.overlay (automouse-layer / scroll-layers / snipe-layers).
 * Keep them in sync when renumbering.
 */

#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/*
 * Layer names are prefixed so the preprocessor cannot rewrite the keymap node
 * names below (a bare `#define MOUSE 1` turns a `MOUSE { }` node into `1 { }`).
 */
#define L_BASE  0
#define L_MOUSE 1   /* automouse-layer -- trackball moves */
#define L_NAV   2
#define L_SYM   3   /* scroll-layers   -- trackball scrolls */
#define L_MAC   4
#define L_SNIPE 5   /* snipe-layers    -- trackball precision */

/* Hold-taps sit only on keys outside the typing flow, so tuning them globally
 * is safe. quick-tap-ms lets Bspc/Enter auto-repeat when tapped then held. */

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

/* Pointer movement (mouse keys) */

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

/* Pointer scrolling (encoder + mouse keys) */

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

/* NAV held -> encoder scrolls three times as fast */

&msc_input_listener {
    fast_scroll {
        layers = <L_NAV>;
        input-processors = <&zip_wheel_scaler 3 1>;
    };
};

/* SYM held -> trackball scrolls instead of moving the pointer.
 * SYM is reachable from the left index (x3), which keeps the whole right hand
 * free for the ball. Y is inverted to match macOS natural scrolling. */

&trackball_listener {
    scroller {
        layers = <L_SYM>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    behaviors {
        kp_enc: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        scrl_enc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* Both left thumb keys at once. Ctrl and Space share the left thumb,
         * so ^Space (input source switch) cannot be pressed as a real chord. */
        ime_toggle {
            bindings = <&kp LC(SPACE)>;
            key-positions = <34 35>;
        };

        del_key {
            bindings = <&kp DEL>;
            key-positions = <7 8>;
        };

        mid_click {
            bindings = <&mkp MB3>;
            key-positions = <16 17>;
        };

        right_click {
            bindings = <&mkp MB2>;
            key-positions = <17 18>;
        };

        back_click {
            bindings = <&mkp MB4>;
            key-positions = <27 28>;
        };

        fwd_click {
            bindings = <&mkp MB5>;
            key-positions = <26 27>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         *  Q      W      E      R      T                  Y      U      I      O      P
         *  A      S      D      F      G                  H      J      K      L      ;
         *  Z      X      C      V      B                  N      M      ,      .      /
         *  Shift  Tab    Esc    SYM    Space  Ctrl  Cmd    Bspc   (o)    Enter  SYM    Shift
         *         (Alt)  (MAC)                                   (NAV)         (MAC)
         */
        base_layer {
            display-name = "Base";
            bindings = <
&kp Q      &kp W          &kp E           &kp R        &kp T                                       &kp Y      &kp U             &kp I               &kp O       &kp P
&kp A      &kp S          &kp D           &kp F        &kp G                                       &kp H      &kp J             &kp K               &kp L       &kp SEMI
&kp Z      &kp X          &kp C           &kp V        &kp B                                       &kp N      &kp M             &kp COMMA           &kp DOT     &kp SLASH
&kp LSHFT  &mt LALT TAB   &lt L_MAC ESC   &mo L_SYM    &kp SPACE   &kp LCTRL     &kp LGUI  &lt L_NAV BSPC                       &lt L_MAC ENTER     &mo L_SYM   &kp RSHFT
            >;

            sensor-bindings = <&scrl_enc SCRL_DOWN SCRL_UP>;
        };

        /*
         * Layer 1 -- entered automatically while the trackball is moving
         * (automouse-layer in LiNEA40_right.overlay). Click cluster lands on
         * the right home row, under the hand already on the ball.
         */
        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans     &trans         &trans          &trans       &trans                                      &trans      &trans           &trans              &trans      &trans
&trans     &trans         &trans          &trans       &trans                                      &mkp MB3    &mkp MB1         &mkp MB2            &mkp MB4    &mkp MB5
&trans     &trans         &trans          &trans       &trans                                      &trans      &trans           &trans              &trans      &trans
&trans     &trans         &trans          &trans       &trans      &trans        &trans    &trans                                &trans              &trans      &trans
            >;
        };

        /*
         * Layer 2 -- hold the right thumb (Bspc), work with the left hand.
         *
         *  Cmd-Alt-Lt  Ctrl-Lt  Ctrl-Up  Ctrl-Rt  Cmd-Alt-Rt      Cmd-[   Cmd-]   .    .    Del
         *  Home        Left     Down     Up       Right           .       .       .    .    Cmd-Bspc
         *  End         PgDn     PgUp     Alt-Lt   Alt-Rt          .       .       .    .    Alt-Bspc
         *
         * Top row is everything that moves a window or a tab: Mission Control
         * in the middle, macOS spaces either side of it, Chrome tabs outermost.
         */
        nav_layer {
            display-name = "Nav";
            bindings = <
&kp LG(LA(LEFT))  &kp LC(LEFT)  &kp LC(UP)  &kp LC(RIGHT)  &kp LG(LA(RIGHT))                       &kp LG(LBKT)  &kp LG(RBKT)   &trans              &trans      &kp DEL
&kp HOME          &kp LEFT      &kp DOWN    &kp UP         &kp RIGHT                               &trans        &trans         &trans              &trans      &kp LG(BSPC)
&kp END           &kp PG_DN     &kp PG_UP   &kp LA(LEFT)   &kp LA(RIGHT)                           &trans        &trans         &trans              &trans      &kp LA(BSPC)
&trans            &trans        &trans      &trans         &trans      &trans    &trans  &trans                                 &trans              &trans      &trans
            >;

            sensor-bindings = <&kp_enc PG_DN PG_UP>;
        };

        /*
         * Layer 3 -- two entry points, so either hand can hold it:
         *   left index (x3)  -> right hand free  -> numbers and operators
         *   right ring (x11) -> left hand free   -> brackets and punctuation
         *
         * US layout, so Shift covers the rest: ~ from `, " from ', ? from /,
         * : from ;. Only the pairs that matter in code get an explicit key.
         */
        sym_layer {
            display-name = "Sym";
            bindings = <
&kp EXCL   &kp AT         &kp HASH        &kp DLLR     &kp PRCNT                                   &kp CARET   &kp N7           &kp N8              &kp N9      &kp ASTRK
&kp LBRC   &kp RBRC       &kp LPAR        &kp RPAR     &kp SQT                                     &kp AMPS    &kp N4           &kp N5              &kp N6      &kp MINUS
&kp LBKT   &kp RBKT       &kp LT          &kp GT       &kp UNDER                                   &kp PIPE    &kp N1           &kp N2              &kp N3      &kp PLUS
&trans     &trans         &kp GRAVE       &trans       &trans      &trans        &trans    &kp N0                                &kp EQUAL           &trans      &trans
            >;

            sensor-bindings = <&kp_enc LG(Z) LG(LS(Z))>;
        };

        /*
         * Layer 4 -- also two entry points, each exposing the opposite hand:
         *   left middle (x2) -> right hand -> Spotlight, input source, Cmd-1..3
         *   right middle (x10) -> left hand -> F1..F12, Bluetooth
         */
        mac_layer {
            display-name = "Mac";
            bindings = <
&kp F1        &kp F2        &kp F3          &kp F4          &kp F5                                  &kp LG(SPACE)      &kp LC(SPACE)      &kp LG(N1)      &kp LG(N2)      &kp LG(N3)
&kp F6        &kp F7        &kp F8          &kp F9          &kp F10                                 &kp LG(LS(N4))     &kp LG(LS(N5))     &kp LG(GRAVE)   &kp LG(LA(I))   &kp LG(LA(ESC))
&kp F11       &kp F12       &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_CLR                              &kp C_MUTE         &kp C_VOL_DN       &kp C_VOL_UP    &kp C_PREV      &kp C_NEXT
&bootloader   &tog L_SNIPE  &trans          &trans          &trans      &trans      &trans  &kp C_PP                                      &trans          &trans          &studio_unlock
            >;

            sensor-bindings = <&kp_enc C_VOL_DN C_VOL_UP>;
        };

        /*
         * Layer 5 -- trackball precision mode (snipe-layers). Toggled from the
         * MAC layer; every key falls through to whatever is underneath.
         */
        snipe_layer {
            display-name = "Snipe";
            bindings = <
&trans     &trans         &trans          &trans       &trans                                      &trans      &trans           &trans              &trans      &trans
&trans     &trans         &trans          &trans       &trans                                      &trans      &trans           &trans              &trans      &trans
&trans     &trans         &trans          &trans       &trans                                      &trans      &trans           &trans              &trans      &trans
&trans     &trans         &trans          &trans       &trans      &trans        &trans    &trans                                &trans              &trans      &trans
            >;
        };
    };
};
